FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "Pillow>=10"
RUN useradd --uid 10001 --no-create-home raid && mkdir /data && chown raid /data
COPY blablalink_union_raid /app/blablalink_union_raid
USER raid
WORKDIR /app
ENV PYTHONUNBUFFERED=1 RAID_DB=/data/history.sqlite3
CMD ["python", "-m", "blablalink_union_raid.server"]
